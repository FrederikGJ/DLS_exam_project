scalar DateTime
scalar Date
scalar BigDecimal

type Query {
  "Booking, payment and baggage read from the booking_overview projection."
  bookingOverview(reference: String!): BookingOverview
  booking(id: ID!): Booking
  bookingByReference(reference: String!): Booking
  bookingsByPassenger(email: String!): [Booking!]!
  passenger(id: ID!): Passenger
}

type Mutation {
  "Creates a booking in status PENDING_PAYMENT. Price is fetched from flight-service."
  createBooking(flightId: ID!, seatNumber: String!, passenger: PassengerInput!): Booking!
  cancelBooking(reference: String!): Booking!
  checkIn(reference: String!): Booking!
}

enum BookingStatus { PENDING_PAYMENT CONFIRMED CANCELLED CHECKED_IN }

type Passenger {
  id: ID!
  firstName: String!
  lastName: String!
  email: String!
  passportNumber: String!
  dateOfBirth: Date
  bookings: [Booking!]!
}

type Booking {
  id: ID!
  "6 character unique reference, e.g. K7Q2ZP"
  bookingReference: String!
  passenger: Passenger!
  flightId: ID!
  "Snapshot of flight data at booking time, kept up to date via flight.* events"
  flightNumber: String!
  departureTime: DateTime!
  gate: String
  flightStatus: String
  seatNumber: String!
  price: BigDecimal!
  currency: String!
  status: BookingStatus!
  createdAt: DateTime!
  updatedAt: DateTime!
}

type BookingOverview {
  booking: BookingOverviewDetails!
  latestPaymentStatus: String
  baggageCount: Int!
  payments: [OverviewPayment!]!
  baggage: [OverviewBaggage!]!
}

type BookingOverviewDetails {
  id: ID!
  bookingReference: String!
  passenger: OverviewPassenger!
  flightId: ID!
  flightNumber: String!
  departureTime: DateTime!
  gate: String
  flightStatus: String
  seatNumber: String!
  price: BigDecimal!
  currency: String!
  status: BookingStatus!
  createdAt: DateTime!
  updatedAt: DateTime!
}

type OverviewPassenger {
  id: ID!
  firstName: String!
  lastName: String!
  email: String!
  passportNumber: String!
  dateOfBirth: Date
}

type OverviewPayment {
  paymentId: ID!
  status: String!
  amount: BigDecimal
  currency: String
  cardLast4: String
  failureReason: String
  createdAt: DateTime
  statusAt: DateTime!
}

type OverviewBaggage {
  tagNumber: String!
  status: String!
  type: String
  weightKg: BigDecimal
  lastLocation: String
  updatedAt: DateTime!
}

input PassengerInput {
  firstName: String!
  lastName: String!
  email: String!
  passportNumber: String!
  dateOfBirth: Date
}
