<?xml version="1.0" encoding="UTF-8"?>
<configuration>
  <appender name="STDOUT" class="ch.qos.logback.core.ConsoleAppender">
    <encoder>
      <pattern>%d{HH:mm:ss.SSS} %-5level %logger{36} - %msg%n</pattern>
    </encoder>
  </appender>

  <!-- stdout/stderr of the booking-service and payment-service containers (Slf4jLogConsumer in Stack).
       Hidden by default; run  mvn verify -Dcontainer.log.level=INFO  to see the full service logs. -->
  <logger name="container" level="${container.log.level:-WARN}"/>

  <logger name="org.testcontainers" level="INFO"/>
  <logger name="tc" level="INFO"/>
  <logger name="com.github.dockerjava" level="WARN"/>

  <root level="INFO">
    <appender-ref ref="STDOUT"/>
  </root>
</configuration>
