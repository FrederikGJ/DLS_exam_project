type Query {
  shops(filter: ShopFilter): [Shop!]!
  shop(id: ID!): Shop
  "Free text search in name, category and description"
  searchShops(text: String!): [Shop!]!
  "Navigation nodes, optionally limited to a terminal and/or floor"
  navNodes(terminal: String, floor: Int): [NavNode!]!
  "All edges (optionally for one terminal) - lets a client draw the map. Edges are bidirectional."
  navEdges(terminal: String): [NavEdge!]!
  "Shortest route (Dijkstra over nav_edge). accessibleOnly=true skips stairs etc."
  route(fromNodeId: ID!, toNodeId: ID!, accessibleOnly: Boolean = false): Route!
  """
  Ask for the way in natural language ("Hvor finder jeg en kop kaffe på vej til gate B12?"). A local language model
  (Ollama) interprets the question and suggests a shop, keyword scoring picks the shop, a destination named in the
  question is recognised, and the route is computed with Dijkstra like `route`. When the model is unavailable the
  keyword search answers alone (aiUsed = false, fallbackReason set).
  """
  askRoute(question: String!, fromNodeId: ID!, accessibleOnly: Boolean = false): AiRouteAnswer!
}

type Mutation {
  createShop(
    input: ShopInput!,
    "Optional, max 64 characters (e.g. a UUID per form). Repeating the call with the same key returns the shop the first call created instead of a duplicate."
    idempotencyKey: String
  ): Shop!
  updateShop(id: ID!, input: ShopInput!): Shop!
  "Soft delete: the row keeps a tombstone (deleted_at) and the shop disappears from every query"
  deleteShop(id: ID!): Boolean!
}

enum ShopCategory { FOOD RETAIL DUTY_FREE SERVICE LOUNGE }
enum NodeType { SHOP GATE SECURITY ENTRANCE JUNCTION ELEVATOR }

type Shop {
  id: ID!
  name: String!
  category: ShopCategory!
  terminal: String!
  zone: String!
  floor: Int!
  "e.g. 06:00-22:00"
  openingHours: String!
  description: String
  node: NavNode
  openNow: Boolean!
}

type NavNode {
  id: ID!
  name: String!
  terminal: String!
  floor: Int!
  x: Int!
  y: Int!
  type: NodeType!
  shops: [Shop!]!
}

type NavEdge {
  id: ID!
  from: NavNode!
  to: NavNode!
  distanceM: Int!
  accessible: Boolean!
}

type RouteStep {
  node: NavNode!
  instruction: String!
  "Distance in metres from the previous step"
  distance: Int!
}

type Route {
  steps: [RouteStep!]!
  totalDistanceM: Int!
  estimatedMinutes: Int!
  "Shops located at a node that is part of the route"
  shopsAlongRoute: [Shop!]!
}

type AiRouteAnswer {
  "One sentence: how the question was understood"
  interpretation: String!
  "The shop the question was mapped to; null when nothing matched"
  shop: Shop
  "Destination named in the question (gate, security, entrance ...), if any"
  toNode: NavNode
  "fromNodeId -> shop (-> toNode); null when no shop matched"
  route: Route
  "true when the language model chose the shop; false when the keyword fallback answered"
  aiUsed: Boolean!
  "Why the fallback was used (model unreachable, timeout, invalid answer, unknown id, AI disabled); null when aiUsed"
  fallbackReason: String
  "Name of the model that answered (null in fallback)"
  model: String
}

input ShopFilter {
  terminal: String
  category: ShopCategory
  openNow: Boolean
}

input ShopInput {
  name: String!
  category: ShopCategory!
  terminal: String!
  zone: String!
  floor: Int!
  openingHours: String!
  description: String
  nodeId: ID
}
