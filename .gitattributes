# Line endings: everything text is stored and checked out with LF, also on Windows.
# The shell script, Dockerfiles, nginx.conf, SQL and YAML run inside Linux containers,
# where CRLF breaks them ("\r: command not found", invalid YAML, etc.).
* text=auto eol=lf

*.sh         text eol=lf
Dockerfile   text eol=lf
*.yml        text eol=lf
*.yaml       text eol=lf
*.sql        text eol=lf
*.conf       text eol=lf
*.graphqls   text eol=lf
*.properties text eol=lf
*.java       text eol=lf
*.js         text eol=lf
*.css        text eol=lf
*.html       text eol=lf
*.md         text eol=lf

# Windows-only scripts keep CRLF
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Binary files
*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.ico  binary
*.pdf  binary
*.jar  binary
*.woff binary
*.woff2 binary
